#!/bin/sh
# Adds the author's Signed-off-by: line to the message, unless it is there, and
# warns (never refuses) when the subject or a line of the body is over 72
# columns; lines that are only a URL, a trailer or a comment are left out.
# Install: cp tools/git-hooks/commit-msg "$(git rev-parse --git-common-dir)/hooks/"
name=$(git config user.name) email=$(git config user.email)
git interpret-trailers --in-place --if-exists addIfDifferent --trailer "Signed-off-by: $name <$email>" "$1"
grep -v '^#' "$1" | awk '
  NR == 1 && length($0) > 72 { printf "commit-msg: subject is %d columns, 72 is the aim\n", length($0) > "/dev/stderr" }
  NR > 1 && length($0) > 72 && $0 !~ /^[A-Za-z-]+: / && $0 !~ /^[[:space:]]*<?https?:\/\/[^[:space:]]*>?$/ {
    printf "commit-msg: line %d is %d columns, 72 is the aim\n", NR, length($0) > "/dev/stderr" }'
exit 0
