        (true (tuatara.frontend.fake:fake-frame-showing f "Page 3 of 3")))
      (pdf-forget)
      (let ((f (pdf-session file nil "g l <wheel-up>" :cell-pixels '(10 20))))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 2 of 3")))
      (pdf-forget))))
