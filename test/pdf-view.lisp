(in-package #:tuatara.tests)

(define-test pdf-view
  :description "Visiting a PDF shows its pages, each drawn in the sandbox as large as the window allows,
l and h turning them, g l and g h to the last and the first, g p to one by number, j and k scrolling
on from page to page, = - p w zooming, d dark, C-s finding text; T switches to its text, where the keys
move as in any text; i says what it says of itself, a lists and saves its embedded files; the mode line
says the page, the zoom and Sandboxed; the page and zoom are kept for the next time. Where pictures are
not shown, the text. A safe visit opens its octets.")

(defun pdf-session (file first then &key cell-pixels (width 120) (height 30))
  "Visit FILE with C-x C-f in an editor session, typing FIRST, then, once what
the PDF's views make in the background is done, THEN; CELL-PIXELS has the
frontend show pictures. Returns the frontend and the editor."
  (let ((f (tuatara.frontend.fake:make-fake-frontend :width width :height height :cell-pixels cell-pixels))
        (start (get-internal-real-time)))
    (let ((scratch (tuatara.buffer:find-buffer "*scratch*")))
      (when scratch (tuatara.buffer:kill-buffer scratch)))
    (tuatara.buffer:make-buffer "*scratch*" :text "")
    (tuatara.frontend.fake:fake-queue-keys f (format nil "C-x C-f C-a C-k ~a RET~@[ ~a~]" (rimu-typed (namestring file)) first))
    (labels ((busy ()
               (or (some (lambda (b) (let ((view (tuatara.defaults::pdf-view-of b)))
                                       (and view (or (tuatara.defaults::pdf-view-job view) (tuatara.defaults::pdf-view-text-job view)))))
                         tuatara.defaults::*pdf-views*)
                   (some #'tuatara.defaults::pdf-view-task-p tuatara.runtime:*jobs*)))
             (check ()
               (if (and (busy) (< (- (get-internal-real-time) start) (* 20 internal-time-units-per-second)))
                   (progn (sleep 0.02) (tuatara.frontend.fake:fake-queue-action f #'check))
                   (when then (tuatara.frontend.fake:fake-queue-keys f then)))))
      (tuatara.frontend.fake:fake-queue-action f #'check))
    (values f (tuatara.command:run-editor f :setup #'tuatara.defaults:install-defaults
                                            :buffer (tuatara.buffer:find-buffer "*scratch*")))))

(defun pdf-forget (&key (places t))
  "Kill the PDF views earlier sessions left, and with PLACES forget the pages
and zooms kept for the next time."
  (dolist (b (copy-list tuatara.defaults::*pdf-views*))
    (when (tuatara.buffer:live-buffer-p b) (tuatara.buffer:kill-buffer b)))
  (when places
    (progn (tuatara.defaults::finish-state-writes) (uiop:delete-file-if-exists (tuatara.defaults::state-list-path tuatara.defaults::*pdf-places*)))))

(defun last-images (f)
  "The pictures of the last frame F painted that had any, each (IMAGE ROW COLUMN COLUMNS ROWS)."
  (find-if #'identity (tuatara.frontend.fake:fake-image-history f)))

(define-test (pdf-view pages)
  (with-test-directory (dir)
    (let ((file (merge-pathnames "report.pdf" dir)))
      (alexandria:write-byte-vector-into-file (pdf-octets '("Hello from page one" "And page two" "Page three")) file)
      ;; its first page, drawn for the window; the mode line says the page, PDF and Sandboxed
      (pdf-forget)
      (multiple-value-bind (f editor) (pdf-session file nil nil :cell-pixels '(10 20))
        (is string= "report.pdf" (tuatara.buffer:buffer-name (tuatara.display:window-buffer (tuatara.command:editor-window editor))))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 1 of 3"))
        (true (tuatara.frontend.fake:fake-frame-showing f "PDF"))
        (true (tuatara.frontend.fake:fake-frame-showing f "Sandboxed"))
        (true (tuatara.frontend.fake:fake-frame-showing f "PDF document, 3 pages"))
        (let ((put (first (last-images f))))
          (true put)
          (is = 3/2 (/ (tuatara.frontend:image-width (first put)) (tuatara.frontend:image-height (first put))))
          ;; as large as the window allows: its 28 rows of 20 pixels, the page wider than high
          (true (> (tuatara.frontend:image-height (first put)) 500)))
        ;; no octets or text under the page
        (false (tuatara.frontend.fake:fake-frame-showing f "%PDF"))
        ;; nothing changed to save: killing it asks nothing, and there is nothing to undo
        (let ((buffer (tuatara.display:window-buffer (tuatara.command:editor-window editor))))
          (false (tuatara.buffer:buffer-modified-p buffer))
          (false (tuatara.buffer:buffer-undo-stack buffer))))
      ;; l and h turn the pages; past the ends, said
      (pdf-forget)
      (multiple-value-bind (f editor) (pdf-session file nil "l" :cell-pixels '(10 20))
        (declare (ignore editor))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 2 of 3, fit page")))
      (pdf-forget)
      (let ((f (pdf-session file nil "g l l" :cell-pixels '(10 20))))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 3 of 3"))
        (true (tuatara.frontend.fake:fake-frame-showing f "The last page")))
      (pdf-forget)
      (let ((f (pdf-session file nil "g l g h h" :cell-pixels '(10 20))))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 3 of 3"))
        (true (tuatara.frontend.fake:fake-frame-showing f "The first page")))
      (pdf-forget)
      (let ((f (pdf-session file nil "g p 3 RET" :cell-pixels '(10 20))))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 3 of 3")))
      ;; the pages drawn differ: page 2 is not page 1
      (pdf-forget)
      (let* ((f (pdf-session file nil "l" :cell-pixels '(10 20)))
             (images (remove-duplicates (loop for frame in (tuatara.frontend.fake:fake-image-history f)
                                              append (mapcar #'first frame)))))
        (true (>= (length images) 2)))
      ;; T: its text, where <next> goes to where the next page begins, j a line as in any text; T again, the pages at that page
      (pdf-forget)
      (let ((f (pdf-session file nil "T <next>" :cell-pixels '(10 20))))
        (true (tuatara.frontend.fake:fake-frame-showing f "Hello from page one"))
        (true (tuatara.frontend.fake:fake-frame-showing f "Text, page 1"))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 2 of 3"))
        (false (tuatara.frontend.fake:fake-images f)))
      (pdf-forget)
      (let ((f (pdf-session file nil "T <next> T" :cell-pixels '(10 20))))
        (true (tuatara.frontend.fake:fake-frame-showing f "Pages, page 2"))
        (true (tuatara.frontend.fake:fake-images f)))
      (pdf-forget))))

(define-test (pdf-view one-copy)
  (with-test-directory (dir)
    (let ((file (merge-pathnames "report.pdf" dir)))
      (alexandria:write-byte-vector-into-file (pdf-octets '("One" "Two" "Three")) file)
      (pdf-forget)
      ;; the PDF copied in memory once for its text and all its pages, closed with the view
      (multiple-value-bind (f editor) (pdf-session file nil "l l" :cell-pixels '(10 20))
        (declare (ignore f))
        (let* ((buffer (tuatara.display:window-buffer (tuatara.command:editor-window editor)))
               (view (tuatara.defaults::pdf-view-of buffer))
               (copy (tuatara.defaults::pdf-view-copy view)))
          (true (tuatara.defaults::pdf-copy-p copy))
          (is = 0 (tuatara.defaults::pdf-copy-users copy))
          (true (tuatara.io::sealed-p (tuatara.defaults::pdf-copy-fd copy)))
          (tuatara.buffer:kill-buffer buffer)
          (false (tuatara.io::sealed-p (tuatara.defaults::pdf-copy-fd copy))))))))

(define-test (pdf-view drawn-ahead-and-kept)
  (with-test-directory (dir)
    (let ((file (merge-pathnames "report.pdf" dir)))
      (alexandria:write-byte-vector-into-file (pdf-octets (loop for i from 1 to 12 collect (format nil "Page ~d" i))) file)
      ;; on page 5: it, the next three and the one before drawn, before they are turned to
      (pdf-forget)
      (multiple-value-bind (f editor) (pdf-session file nil "g p 5 RET" :cell-pixels '(10 20))
        (declare (ignore f))
        (let ((view (tuatara.defaults::pdf-view-of (tuatara.display:window-buffer (tuatara.command:editor-window editor)))))
          (loop repeat 200 while (tuatara.defaults::pdf-view-job view) do (sleep 0.02) (tuatara.defaults::pdf-view-tick nil))
          (true (subsetp '(4 5 6 7 8) (mapcar #'first (tuatara.defaults::pdf-view-images view))))
          (is equal '(5 6 7 8 4) (tuatara.defaults::pdf-view-wanted-pages view))))
      ;; past the memory allowed: the farthest let go of, never the page shown
      (let* ((image (lambda () (tuatara.frontend:make-image 10 10 3 (make-array 300 :element-type '(unsigned-byte 8)))))
             (view (tuatara.defaults::make-pdf-view "x.pdf"))
             (tuatara.defaults::*pdf-view-memory* 1000))
        (setf (tuatara.defaults::pdf-view-page view) 5
              (tuatara.defaults::pdf-view-images view)
              (loop for p in '(1 9 5 6 4) collect (list p 100 (funcall image) nil)))
        (tuatara.defaults::pdf-view-let-go view 100)
        (is equal '(5 6 4) (mapcar #'first (tuatara.defaults::pdf-view-images view)))
        (setf tuatara.defaults::*pdf-view-memory* 0)
        (tuatara.defaults::pdf-view-let-go view 100)
        (is equal '(5) (mapcar #'first (tuatara.defaults::pdf-view-images view))))
      (pdf-forget))))

(define-test (pdf-view never-its-text-between-pages)
  ;; pages turned faster than they are drawn: the page before stays, or nothing, never the text in its place
  (with-test-directory (dir)
    (let ((file (merge-pathnames "report.pdf" dir)))
      (alexandria:write-byte-vector-into-file (pdf-octets '("Zebra one" "Zebra two" "Zebra three" "Zebra four" "Zebra five")) file)
      (pdf-forget)
      (let ((f (pdf-session file nil "l l l l h h h" :cell-pixels '(10 20))))
        (true (tuatara.frontend.fake:fake-images f))
        (false (tuatara.frontend.fake:fake-frame-showing f "Zebra")))
      ;; the text itself still with T
      (pdf-forget)
      (let ((f (pdf-session file nil "T" :cell-pixels '(10 20))))
        (true (tuatara.frontend.fake:fake-frame-showing f "Zebra one")))
      (pdf-forget))))

(define-test (pdf-view pages-not-drawn)
  (with-test-directory (dir)
    (let ((file (merge-pathnames "report.pdf" dir)))
      (alexandria:write-byte-vector-into-file (pdf-octets '("Hello from page one" "And page two" "Page three")) file)
      ;; a page its program cannot draw: said, and not tried again and again
      (pdf-forget)
      (let ((tuatara.defaults::*pdf-decoders*
              (list (append '(:page ("sh" "-c" "exit 1")) (first tuatara.defaults::*pdf-decoders*))))
            (start (get-internal-real-time)))
        (multiple-value-bind (f editor) (pdf-session file nil "j" :cell-pixels '(10 20))
          (true (< (- (get-internal-real-time) start) (* 10 internal-time-units-per-second)))
          (true (tuatara.frontend.fake:fake-frame-showing f "Page 1 could not be drawn"))
          (let ((view (tuatara.defaults::pdf-view-of (tuatara.display:window-buffer (tuatara.command:editor-window editor)))))
            (false (tuatara.defaults::pdf-view-job view))
            (true (find 1 (tuatara.defaults::pdf-view-images view) :key #'first)))))
      ;; where the pages begin in the text, in octets, characters of more than one octet before
      (is equalp #() (tuatara.defaults::text-page-starts "One page only"))
      (let ((text (tuatara.defaults::pdf-pages-text (format nil "é one~%~ctwo~%~cthree~c" #\Page #\Page #\Page))))
        (is equalp (vector (search (tuatara.text:string-octets (format nil "~a2" tuatara.defaults::*pdf-page-mark*))
                                   (tuatara.text:string-octets text))
                           (search (tuatara.text:string-octets (format nil "~a3" tuatara.defaults::*pdf-page-mark*))
                                   (tuatara.text:string-octets text)))
            (tuatara.defaults::text-page-starts text)))
      ;; k k before the page before is drawn: on to its end, then up from there, no error
      (pdf-forget)
      (multiple-value-bind (f editor) (run-keys "l k k k" :file (namestring file) :width 120 :height 20 :cell-pixels '(10 20))
        (declare (ignore editor))
        (false (tuatara.frontend.fake:fake-frame-showing f "error"))
        (false (tuatara.frontend.fake:fake-frame-showing f "is not of type")))
      (pdf-forget))))

(define-test (pdf-view fitted-page-fits)
  ;; a page fitted whole takes no more rows than its window has, at any height: nothing to
  ;; scroll, j turns the page
  (with-test-directory (dir)
    (let ((file (merge-pathnames "report.pdf" dir)))
      (alexandria:write-byte-vector-into-file (pdf-octets '("one" "two")) file)
      (loop for (width height) in '((60 20) (200 12) (200 17) (200 23) (200 29) (200 34) (200 41))
            do (pdf-forget)
               (multiple-value-bind (f editor) (pdf-session file nil "j" :cell-pixels '(10 20) :width width :height height)
                 (let ((shown (first (last-images f)))
                       (rows (tuatara.display:window-height (tuatara.command:editor-window editor))))
                   (true (tuatara.frontend.fake:fake-frame-showing f "Page 2 of 2") "~dx~d" width height)
                   (true shown)
                   (when shown
                     (true (<= (fifth shown) rows) "~d rows in a window of ~d" (fifth shown) rows)))))
      ;; a fitted page a pixel taller than its window still leaves nothing to scroll
      (pdf-forget)
      (multiple-value-bind (f editor) (pdf-session file nil nil :cell-pixels '(10 20) :width 200 :height 20)
        (declare (ignore f))
        (let* ((window (tuatara.command:editor-window editor))
               (buffer (tuatara.display:window-buffer window))
               (height (1+ (* 20 (tuatara.display:window-height window)))))
          (setf (tuatara.buffer:buffer-local buffer :image)
                (tuatara.frontend:make-image 10 height 3 (make-array (* 30 height) :element-type '(unsigned-byte 8))))
          (let ((tuatara.command:*editor* editor))
            (is = 0 (tuatara.defaults::pdf-view-last-top buffer (tuatara.defaults::pdf-view-of buffer))))))
      (pdf-forget))))

(define-test (pdf-view text-and-octets)
  (with-test-directory (dir)
    (let ((file (merge-pathnames "report.pdf" dir)))
      (alexandria:write-byte-vector-into-file (pdf-octets '("Hello from page one" "And page two")) file)
      ;; where pictures are not shown: the text, the same keys going from page to page
      (pdf-forget)
      (let ((f (pdf-session file nil "<next>")))
        (true (tuatara.frontend.fake:fake-frame-showing f "Hello from page one"))
        (true (tuatara.frontend.fake:fake-frame-showing f "── Page 2 ──"))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 2 of 2"))
        (false (tuatara.frontend.fake:fake-images f)))
      ;; a PDF the editor is started with shows its pages too
      (pdf-forget)
      (multiple-value-bind (f editor) (run-keys "" :file (namestring file) :width 120 :height 20 :cell-pixels '(10 20))
        (declare (ignore f))
        (let ((buffer (tuatara.display:window-buffer (tuatara.command:editor-window editor))))
          (true (tuatara.defaults::pdf-view-of buffer))))
      ;; M-x hex-mode in the view: the PDF's own octets, opened safely, in the hex view
      (pdf-forget)
      (multiple-value-bind (f editor) (pdf-session file nil "M-x h e x - m o d e RET" :cell-pixels '(10 20))
        (let ((buffer (tuatara.display:window-buffer (tuatara.command:editor-window editor))))
          (true (tuatara.display:hex-view-p buffer))
          (true (tuatara.io:safe-visit-p buffer))
          (true (tuatara.frontend.fake:fake-frame-showing f "00000000  25 50 44 46"))
          (true (tuatara.frontend.fake:fake-frame-showing f "report.pdf's octets, opened safely"))
          (tuatara.buffer:kill-buffer buffer)))
      ;; a safe visit opens its octets, not the view
      (pdf-forget)
      (multiple-value-bind (f editor)
          (run-keys (format nil "C-u C-x C-f C-a C-k ~a RET" (rimu-typed (namestring file))) :width 120 :height 20 :cell-pixels '(10 20))
        (declare (ignore f))
        (let ((buffer (tuatara.display:window-buffer (tuatara.command:editor-window editor))))
          (true (tuatara.buffer:buffer-file buffer))
          (false (tuatara.defaults::pdf-view-of buffer))
          (tuatara.buffer:kill-buffer buffer)))
      ;; no sandbox: the octets, and why
      (pdf-forget)
      (let ((tuatara-user:*sandbox-program* nil))
        (multiple-value-bind (f editor) (pdf-session file nil nil :cell-pixels '(10 20))
          (true (tuatara.frontend.fake:fake-frame-showing f "report.pdf opens as octets: decoding is off"))
          (let ((buffer (tuatara.display:window-buffer (tuatara.command:editor-window editor))))
            (false (tuatara.defaults::pdf-view-of buffer))
            (tuatara.buffer:kill-buffer buffer))))
      (tuatara.io:sandbox-status :again t)
      (pdf-forget))))

(define-test (pdf-view zoom-and-scroll)
  (with-test-directory (dir)
    (let ((file (merge-pathnames "report.pdf" dir)))
      (alexandria:write-byte-vector-into-file (pdf-octets '("Hello from page one" "And page two")) file)
      (flet ((widest (f) (reduce #'max (loop for frame in (tuatara.frontend.fake:fake-image-history f)
                                             append (mapcar (lambda (put) (tuatara.frontend:image-width (first put))) frame))
                                 :initial-value 0)))
        ;; = draws the page larger, - smaller, w as wide as the window, p whole again
        (pdf-forget)
        (let* ((fit (widest (pdf-session file nil nil :cell-pixels '(10 20) :width 60 :height 20)))
               (f (progn (pdf-forget) (pdf-session file nil "= =" :cell-pixels '(10 20) :width 60 :height 20))))
          (true (tuatara.frontend.fake:fake-frame-showing f "Page 1 of 2, 156%"))
          (true (> (widest f) fit)))
        (pdf-forget)
        (let ((f (pdf-session file nil "w" :cell-pixels '(10 20) :width 60 :height 20)))
          (true (tuatara.frontend.fake:fake-frame-showing f "fit width")))
        (pdf-forget)
        (let ((f (pdf-session file nil "= p" :cell-pixels '(10 20) :width 60 :height 20)))
          (true (tuatara.frontend.fake:fake-frame-showing f "Zoom: fit page")))
        ;; 0: back to the fit chosen, not zoomed
        (pdf-forget)
        (let ((f (pdf-session file nil "w = = 0" :cell-pixels '(10 20) :width 60 :height 20)))
          (true (tuatara.frontend.fake:fake-frame-showing f "Zoom: fit width")))
        ;; zoomed in, j scrolls the page down, shown from a lower row; at its end on to the next page
        (pdf-forget)
        (let ((f (pdf-session file "= = = =" "j" :cell-pixels '(10 20) :width 60 :height 20)))
          (true (find-if (lambda (frame) (some (lambda (put) (and (sixth put) (plusp (first (sixth put))))) frame))
                         (tuatara.frontend.fake:fake-image-history f))))
        (pdf-forget)
        (let ((f (pdf-session file nil "j" :cell-pixels '(10 20) :width 60 :height 20)))
          (true (tuatara.frontend.fake:fake-frame-showing f "Page 2 of 2")))
        (pdf-forget)
        (let ((f (pdf-session file nil "l k" :cell-pixels '(10 20) :width 60 :height 20)))
          (true (tuatara.frontend.fake:fake-frame-showing f "Page 1 of 2")))
        ;; zoomed in, g e shows the page's bottom, g g its top
        (flet ((top-shown (f) (let ((put (first (tuatara.frontend.fake:fake-images f)))) (and put (first (sixth put))))))
          (pdf-forget)
          (let ((f (pdf-session file "= = = =" "g e" :cell-pixels '(10 20) :width 60 :height 20)))
            (true (plusp (top-shown f)))
            (true (tuatara.frontend.fake:fake-frame-showing f "Page 1 of 2")))
          (pdf-forget)
          (let ((f (pdf-session file "= = = = g e" "g g" :cell-pixels '(10 20) :width 60 :height 20)))
            (is = 0 (top-shown f))))
        (pdf-forget)))))

(define-test (pdf-view dark-search-facts)
  (with-test-directory (dir)
    (let ((file (merge-pathnames "report.pdf" dir))
          (dark tuatara.defaults::*pdf-view-dark-pages*))
      (alexandria:write-byte-vector-into-file (pdf-octets '("Hello from page one" "And page two" "Page three")) file)
      ;; d: the page dark, its white the theme's ground
      (unwind-protect
           (progn
             (pdf-forget)
             (let* ((f (pdf-session file nil "d" :cell-pixels '(10 20)))
                    (image (first (first (tuatara.frontend.fake:fake-images f)))))
               (true (tuatara.frontend.fake:fake-frame-showing f "Pages dark"))
               (false (= 255 (aref (tuatara.frontend:image-pixels image) 0)))))
        (setf tuatara.defaults::*pdf-view-dark-pages* dark))
      ;; a dark page is made again when the theme's colours change, not kept from before
      (let* ((image (tuatara.frontend:make-image 1 1 3 (coerce '(255 255 255) '(simple-array (unsigned-byte 8) (*)))))
             (entry (list 1 1 image nil))
             (tuatara.defaults::*pdf-view-dark-pages* t)
             (first (tuatara.defaults::pdf-view-shown-image entry)))
        (is eq first (tuatara.defaults::pdf-view-shown-image entry))
        (incf tuatara.display:*face-generation*)
        (false (eq first (tuatara.defaults::pdf-view-shown-image entry))))
      ;; the colours turned about: white the ground, black the ink, grey between, alpha kept
      (let ((dark (tuatara.defaults::dark-image
                   (tuatara.frontend:make-image 3 1 4 (coerce '(255 255 255 9 0 0 0 200 255 0 51 255) '(simple-array (unsigned-byte 8) (*))))
                   (list 0 200 210 220 10 20 30))))
        (is equalp #(10 20 30 9 200 210 220 200 10 210 182 255) (tuatara.frontend:image-pixels dark)))
      ;; a page drawn while pages are dark comes with its dark picture, made while it was drawn
      (unwind-protect
           (progn
             (pdf-forget)
             (setf tuatara.defaults::*pdf-view-dark-pages* t)
             (multiple-value-bind (f editor) (pdf-session file nil "l" :cell-pixels '(10 20))
               (declare (ignore f))
               (let* ((view (tuatara.defaults::pdf-view-of (tuatara.display:window-buffer (tuatara.command:editor-window editor))))
                      (entry (find 3 (tuatara.defaults::pdf-view-images view) :key #'first)))
                 (true entry)
                 (is eql tuatara.display:*face-generation* (car (fourth entry))))))
        (setf tuatara.defaults::*pdf-view-dark-pages* dark))
      ;; C-s: the page the text is on, and the line
      (pdf-forget)
      (let ((f (pdf-session file nil "C-s p a g e SPC t w o RET" :cell-pixels '(10 20))))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 2: And page two"))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 2 of 3")))
      ;; again with nothing typed: the next place, case ignored, on to the last page
      (pdf-forget)
      (let ((f (pdf-session file nil "C-s p a g e RET C-s RET C-s RET C-s RET" :cell-pixels '(10 20))))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 3: "))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 3 of 3")))
      ;; i: what it says of itself, beside it
      (pdf-forget)
      (let ((f (pdf-session file "i" nil :cell-pixels '(10 20) :width 160)))
        (true (tuatara.frontend.fake:fake-frame-showing f "What report.pdf says of itself"))
        (true (tuatara.frontend.fake:fake-frame-showing f "Pages:"))
        (true (tuatara.frontend.fake:fake-frame-showing f "PDF version:"))
        ;; the file's own size, not the 0 of what its program read through a pipe
        (false (tuatara.frontend.fake:fake-frame-showing f "0 bytes")))
      (pdf-forget))))

(define-test (pdf-view embedded-files)
  (with-test-directory (dir)
    (let ((file (merge-pathnames "report.pdf" dir))
          (saved (merge-pathnames "note.txt" dir)))
      (alexandria:write-byte-vector-into-file (pdf-octets '("Hello") :attachment '("../note.txt" "secret inside")) file)
      ;; a: listed beside it; s on it saves it where asked, by a plain name, not opened
      (pdf-forget)
      (let ((f (pdf-session file "a" "C-x o s RET" :cell-pixels '(10 20) :width 160)))
        (true (tuatara.frontend.fake:fake-frame-showing f "1 embedded file"))
        (true (tuatara.frontend.fake:fake-frame-showing f "../note.txt"))
        (true (loop repeat 200 thereis (probe-file saved) do (sleep 0.02)))
        (is string= "secret inside" (alexandria:read-file-into-string saved)))
      ;; the PDF's view killed before the saving: saved all the same, and said
      (delete-file saved)
      (pdf-forget)
      (let ((f (pdf-session file "a" "C-x k C-x o s RET" :cell-pixels '(10 20) :width 160)))
        (true (loop repeat 200 thereis (probe-file saved) do (sleep 0.02)))
        (true (tuatara.frontend.fake:fake-frame-showing f "Saved "))
        (false (find "report.pdf" tuatara.buffer:*buffers* :key #'tuatara.buffer:buffer-name :test #'string=)))
      ;; a name with a line of its own in it: one file still, never another made up
      (is equal '((1 "a 7: forged") (2 "b"))
          (tuatara.defaults::embedded-names (format nil "2 embedded files~%1: a~%7: forged~%~%2: b~%~%")))
      ;; a PDF with none says so
      (pdf-forget)
      (alexandria:write-byte-vector-into-file (pdf-octets '("Hello")) file :if-exists :supersede)
      (let ((f (pdf-session file "a" nil :cell-pixels '(10 20))))
        (true (tuatara.frontend.fake:fake-frame-showing f "report.pdf has no embedded files")))
      (pdf-forget))))

(define-test (pdf-view embedded-files-narrowed)
  (with-test-directory (dir)
    (let ((file (merge-pathnames "report.pdf" dir)))
      (alexandria:write-byte-vector-into-file
       (pdf-octets '("Hello") :attachments '(("budget.xlsx" "numbers") ("minutes.txt" "the minutes") ("photo.jpg" "picture")))
       file)
      (flet ((listed (then)
               (pdf-forget)
               (let ((f (pdf-session file "a" then :cell-pixels '(10 20) :width 160)))
                 (values (tuatara.buffer:buffer-string (tuatara.buffer:find-buffer "*PDF embedded files*")) f)))
             (saved-files ()
               (sort (mapcar #'file-namestring (uiop:directory-files dir)) #'string<)))
        ;; narrowed by a name, as every list is
        (let ((text (listed "C-x o C-x / s m i n u t e s RET")))
          (true (search "Filtered by minutes: 1 of 3" text) text)
          (true (search "minutes.txt" text))
          (false (search "budget.xlsx" text))
          (false (search "photo.jpg" text)))
        ;; C-x / r shows them all again
        (let ((text (listed "C-x o C-x / s m i n u t e s RET C-x / r")))
          (false (search "Filtered by" text))
          (true (search "budget.xlsx" text))
          (true (search "photo.jpg" text)))
        ;; s saves the file on the line among those the filter leaves, that one only
        (listed "C-x o C-x / s p h o t o RET n s RET")
        (let ((saved (merge-pathnames "photo.jpg" dir)))
          (true (loop repeat 200 thereis (probe-file saved) do (sleep 0.02)))
          (is string= "picture" (alexandria:read-file-into-string saved))
          (is equal '("photo.jpg" "report.pdf") (saved-files))
          (delete-file saved))
        ;; what is typed after C-x / s is the pattern: s a v e RET saves nothing
        (multiple-value-bind (text f) (listed "C-x o C-x / s s a v e RET")
          (true (search "Filtered by save: 0 of 3" text) text)
          (dolist (name '("budget.xlsx" "minutes.txt" "photo.jpg"))
            (false (tuatara.frontend.fake:fake-frame-showing f (format nil "Save ~a to:" name))))
          (sleep 0.2)
          (is equal '("report.pdf") (saved-files))))
      (pdf-forget))))

(define-test (pdf-view kept-for-next-time)
  (with-test-directory (dir)
    (let ((file (merge-pathnames "report.pdf" dir)))
      (alexandria:write-byte-vector-into-file (pdf-octets '("One" "Two" "Three")) file)
      ;; left at page 3, fit width: opened there again
      (pdf-forget)
      (pdf-session file nil "g l w" :cell-pixels '(10 20))
      (pdf-forget :places nil)
      (let ((f (pdf-session file nil nil :cell-pixels '(10 20))))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 3 of 3, fit width")))
      (pdf-forget)
      ;; a path of the file relative to the directory stood in finds it a PDF all the same
      (let ((tuatara-user:*default-directory* (namestring dir)))
        (let ((buffer (tuatara.defaults::pdf-view-visit "report.pdf" #'identity)))
          (true buffer)
          (when buffer (tuatara.buffer:kill-buffer buffer)))))))

(define-test (pdf-view pdf-in-odd-directories)
  ;; a PDF in a directory whose name holds [ ] and *: shown, its view standing in that directory
  (with-test-directory (dir)
    (let* ((directory (concatenate 'string (tuatara.io:native dir) "papers [1]*/"))
           (file (concatenate 'string directory "report.pdf")))
      (sb-posix:mkdir directory #o700)
      (alexandria:write-byte-vector-into-file (pdf-octets '("Hello")) (sb-ext:parse-native-namestring file))
      (pdf-forget)
      (let ((buffer (tuatara.defaults::pdf-view-visit file #'identity)))
        (unwind-protect
             (progn
               (true buffer)
               (when buffer
                 (is string= directory (tuatara.buffer:buffer-local buffer :directory))))
          (when buffer (tuatara.buffer:kill-buffer buffer))))
      (pdf-forget))))

(define-test (pdf-view search-case-as-everywhere)
  ;; C-s in a PDF reads case as every search does: ignored while no capital is typed, and
  ;; heeded once one is
  (with-test-directory (dir)
    (let ((file (merge-pathnames "birds.pdf" dir)))
      (alexandria:write-byte-vector-into-file (pdf-octets '("tui one" "kea two" "Tui three")) file)
      (pdf-forget)
      (let ((f (pdf-session file nil "C-s T u i RET" :cell-pixels '(10 20))))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 3: Tui three")))
      (pdf-forget)
      (let ((f (pdf-session file nil "C-s t u i RET C-s RET" :cell-pixels '(10 20))))
        (true (tuatara.frontend.fake:fake-frame-showing f "Page 3: Tui three")))
      (pdf-forget))))

(define-test (pdf-view wheel-turns-the-pages)
  ;; the mouse wheel scrolls the pages as j and k do: the page fitted whole, a turn a page
  (with-test-directory (dir)
    (let ((file (merge-pathnames "wheel.pdf" dir)))
      (alexandria:write-byte-vector-into-file (pdf-octets '("one" "two" "three")) file)
